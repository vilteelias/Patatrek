package com.patatrek.backend.contingencia.estrategias;

import com.patatrek.backend.contingencia.*;
import com.patatrek.backend.salida.Salida;
import com.patatrek.backend.reserva.Reserva;
import com.patatrek.backend.reserva.ReservaRepository;
import com.patatrek.backend.correo.ServicioCorreo;
import org.springframework.stereotype.Component;
import java.util.List;

@Component("CANCELACION") // 👈 El nombre debe coincidir con el valor del DTO
public class CancelacionStrategy implements ResolucionContingenciaStrategy {

    private final ReservaRepository reservaRepository;
    private final ServicioCorreo servicioCorreo;

    public CancelacionStrategy(ReservaRepository reservaRepository, ServicioCorreo servicioCorreo) {
        this.reservaRepository = reservaRepository;
        this.servicioCorreo = servicioCorreo;
    }

    @Override
    public void procesarResolucion(Salida salida, Contingencia contingencia, ContingenciaDTO dto) {
        salida.setEstadoSalida("Cancelada");[cite: 63, 65]
        // salida.liberarRecursos(); // Implementa este método en Salida para limpiar guías y refugios[cite: 63, 65]
        
        List<Reserva> reservas = reservaRepository.findVigentesBySalida(salida.getIdSalida());
        for (Reserva reserva : reservas) {
            reserva.setEstadoReserva("Pendiente_Devolucion");[cite: 63, 65]
            reservaRepository.save(reserva);
            servicioCorreo.enviarMailCancelacion(reserva.getCliente().getCorreoElectronico(), reserva.getIdReserva(), dto.getMotivo());[cite: 65]
        }
    }
}